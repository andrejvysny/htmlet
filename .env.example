# Copy to .env and edit. docker-compose reads this automatically.

# REQUIRED. Comma-separated upload tokens (any one grants upload/list/delete).
# Generate a strong one:  openssl rand -hex 32   (or: htmlet genkey)
# NOTE: the app refuses to start on weak/placeholder keys (min 16 chars; the value
# below is rejected on purpose) — replace it with a real key before deploying.
API_KEYS=REPLACE_WITH_openssl_rand_hex_32

# Max upload size in bytes (default 5 MiB). Enforced for raw and multipart uploads.
MAX_UPLOAD_BYTES=5242880

# Cap on total stored pages (default 10000). Creating beyond it returns HTTP 507.
MAX_FILES=10000

# Image tag pulled by the compose files. CI pushes `latest`, `sha-<commit>`, and
# `X.Y.Z` tags to ghcr.io/williambrach/htmlet (see .github/workflows/build.yml).
# Pin to a sha-* tag for reproducible deploys; default is latest.
# HTMLET_TAG=latest

# Public origin used when building returned links. Recommended in production so
# links point at your real domain AND a client can't spoof the host in returned
# URLs. BASE_URL=https://share.example.com

# Upstream IPs/CIDRs allowed to set X-Forwarded-* (default 127.0.0.1). Set this to
# your reverse-proxy's network so the HTTPS scheme is detected. With the bundled
# docs/traefik/docker-compose.yml this is already pinned to the internal subnet, so you
# don't need to set it there. For a hand-rolled proxy, e.g.:
# FORWARDED_ALLOW_IPS=10.0.0.0/8

# Web-UI session cookies. SESSION_SECRET defaults to a value derived from
# API_KEYS (rotating keys signs everyone out); set it to keep sessions stable.
# SESSION_SECRET=another-long-random-string
# SESSION_MAX_AGE=2592000  # seconds a UI session stays valid (default 30 days)

# Content-Security-Policy applied to every SERVED page. The default sandboxes
# each page into an opaque origin (it cannot read your domain's cookies or talk
# to other pages) while still letting the page's own scripts/forms run.
#   - Remove `allow-scripts` to disable JS in hosted pages entirely.
#   - Set to an empty string to disable the CSP header.
# CONTENT_SECURITY_POLICY=sandbox allow-scripts allow-forms allow-popups allow-modals allow-downloads

# --- Production TLS via Traefik (docs/traefik/docker-compose.yml) ----------- #
# Serve hosted pages on a DIFFERENT host than the admin/API so a malicious uploaded
# page can never share cookies with the admin session (the key isolation control).
# ACME_EMAIL=you@example.com
# ADMIN_HOST=admin.example.com    # admin UI + write API
# PAGES_HOST=share.example.com    # public hosted pages (set BASE_URL to https://this)
